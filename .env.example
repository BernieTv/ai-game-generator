# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit .env.local. In production, set these in your hosting provider.

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk (auth, organizations, billing) ─ https://dashboard.clerk.com ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/studio
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/studio

# ── Postgres (Neon recommended) ─ https://console.neon.tech ─────────────
# Pooled connection string, used by the app and the worker.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection string, used only by `npm run db:push`.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Anthropic (Claude) ─ https://platform.claude.com ────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Trigger.dev (durable agent runs) ─ https://cloud.trigger.dev ────────
# Use the DEV secret key locally and the PROD key in production.
TRIGGER_SECRET_KEY=tr_dev_xxx
TRIGGER_PROJECT_REF=proj_xxx

# ── Daytona (game sandboxes) ─ https://app.daytona.io ───────────────────
DAYTONA_API_KEY=dtn_xxx

# ── Sentry (optional error monitoring) ─ https://sentry.io ──────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Only needed to upload source maps during production builds.
SENTRY_AUTH_TOKEN=
